# Non-secret sample settings. Copy to .env on the server and replace placeholders.
# Pick a supported, tested OJS image/version from PKP's official container project.
# Do NOT deploy until image provenance, configuration and persistence paths are verified.
OJS_IMAGE=REPLACE_WITH_VERIFIED_PKP_IMAGE_AND_IMMUTABLE_DIGEST

# Pin a supported MariaDB release or immutable digest before deployment.
MARIADB_IMAGE=REPLACE_WITH_VERIFIED_MARIADB_IMAGE_AND_DIGEST
MARIADB_DATABASE=ojs
MARIADB_USER=ojs
MARIADB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
MARIADB_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_ROOT_PASSWORD

# Do not commit the real .env file.
